NODE_ENV=development
PORT=3001
# MongoDB Atlas example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dayflow?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dayflow?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
FRONTEND_URL=http://localhost:9002
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CRON_SECRET=replace-with-a-long-random-cron-secret
PASSWORD_ENCRYPTION_KEY=replace-with-a-32-byte-key-for-credential-encryption
# Resend (https://resend.com) — used to send password-reset emails.
RESEND_API_KEY=replace-with-your-resend-api-key
MAIL_FROM_ADDRESS=DayFlow <onboarding@resend.dev>